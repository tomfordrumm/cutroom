# Written by install.sh. Edit and run `docker compose up -d` to apply.

# Owner password for the web interface.
CUTROOM_PASSWORD=change-me
# Signs the login cookie. Any long random string.
CUTROOM_SECRET=change-me-too

# Where the web interface listens on the host. 127.0.0.1 = this machine only.
CUTROOM_BIND=127.0.0.1
CUTROOM_PORT=8080

# Real server with a domain: set it and add the https profile
# (COMPOSE_PROFILES=https). Caddy then gets a certificate automatically.
CUTROOM_DOMAIN=
COMPOSE_PROFILES=

# Local build instead of the published image (install.sh --source sets these).
# COMPOSE_FILE=compose.yml:compose.build.yml
# ORC_PATH=../VideoEditor

# Speech recognition. The model is picked in Settings → Распознавание речи;
# this is only the default before that (base, small, large-v3-turbo-q5_0, large-v3-turbo).
# CUTROOM_WHISPER_MODEL=small
# CPU threads for Whisper (default 4).
# CUTROOM_WHISPER_THREADS=4

# Telegram API base for tests; the default is https://api.telegram.org.
# CUTROOM_TELEGRAM_API=
