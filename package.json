{
  "name": "cutroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted AI video editing room: a kanban of videos, an editing agent on your own subscription, versions and comments until a cut is accepted.",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@remotion/bundler": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "node-pty": "1.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538",
    "ws": "8.23.0"
  },
  "bin": {
    "cutroom": "src/cli.js"
  }
}
